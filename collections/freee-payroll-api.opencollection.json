                "value": "",
                "type": "query"
              },
              {
                "name": "month",
                "value": "",
                "type": "query"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query"
              },
              {
                "name": "offset",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Lists employee salary payroll statements (給与明細) for an HR company and pay month."
        }
      ]
    }
  ],
  "bundled": true
}